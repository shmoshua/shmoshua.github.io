+
+/* ---- TL;DR box at the top of a post ----
+   Usage: <div class="tldr"> <p>…</p> </div>
+   Outlined instead of tinted, so it doesn't read as a theorem. */
+.tldr {
+  position: relative;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 1.15rem 1.3rem .95rem;
+  margin: 1.4rem 0 2.2rem;
+  font-size: .95em;
+}
+.tldr::before {
+  content: "TL;DR";
+  position: absolute;
+  top: -.62rem;
+  left: 1rem;
+  padding: 0 .45rem;
+  background: var(--paper);
+  font-family: var(--mono);
+  font-size: .68rem;
+  letter-spacing: .16em;
+  color: var(--accent);
+}
+.tldr > :last-child { margin-bottom: 0; }
+.tldr ul, .tldr ol { padding-left: 1.2rem; }
diff --git a/js/toc.js b/js/toc.js
index c38cef0..30a4ec8 100644
--- a/js/toc.js
+++ b/js/toc.js
@@ -4,7 +4,10 @@
   var nav = document.querySelector('nav.toc');
   if (!nav) return;
 
-  var heads = document.querySelectorAll('article.article h2, article.article h3');
+  // Headings inside a TL;DR box are left out of the contents
+  var heads = Array.prototype.filter.call(
+    document.querySelectorAll('article.article h2, article.article h3'),
+    function (h) { return !h.closest('.tldr'); });
   if (!heads.length) { nav.remove(); return; }
 
   var title = document.createElement('div');
