diff --git a/css/style.css b/css/style.css
index a64b6a3..b2eedaf 100644
--- a/css/style.css
+++ b/css/style.css
@@ -482,4 +482,30 @@ a:focus-visible, .links a:focus-visible, input:focus-visible {
 
 /* Numbered and bullet lists inside posts */
 article.article ol, article.article ul { padding-left: 1.5rem; margin: 0 0 1.1rem; }
-article.article li { margin-bottom: .3rem; }
\ No newline at end of file
