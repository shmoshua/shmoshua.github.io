new file mode 100644
index 0000000..cb5fbfb
--- /dev/null
+++ b/attempts.html
@@ -0,0 +1,65 @@
+---
+title: Attempts
+permalink: /attempts/
+---
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Attempts · {{ site.title }}</title>
+  <link rel="preconnect" href="https://fonts.googleapis.com">
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
+  <link rel="stylesheet" href="{{ '/css/style.css' | relative_url }}">
+</head>
+<body>
+{% include nav.html current="attempts" %}
+
+<header class="masthead article">
+  <p class="eyebrow">Ideas in progress</p>
+  <h1 class="title">Attempts</h1>
+  <p class="abstract">One page per idea, with a dated log of how it develops: what I tried, what broke, and what I changed.</p>
+</header>
+
+<main class="article">
+  <!-- Built automatically from the files in _attempts/, most recently worked on first.
+       Dates and entry counts come from the <h2 class="entry" data-date="..."> headings. -->
+  {% capture rows %}{% for a in site.attempts %}{% assign parts = a.content | split: 'data-date="' %}{% assign last = parts | last | slice: 0, 10 %}{% if parts.size < 2 %}{% assign last = "0000-00-00" %}{% endif %}{{ last }}|{{ forloop.index0 }};;{% endfor %}{% endcapture %}
+  {% assign rows = rows | split: ";;" | sort | reverse %}
+
+  {% if site.attempts.size > 0 %}
+  <ul class="post-list idea-list">
+    {% for row in rows %}
+    {% unless row contains "|" %}{% continue %}{% endunless %}
+    {% assign i = row | split: "|" | last | plus: 0 %}
+    {% assign a = site.attempts[i] %}
+    {% assign parts = a.content | split: 'data-date="' %}
+    {% assign n = parts.size | minus: 1 %}
+    {% assign first = parts[1] | slice: 0, 10 %}
+    {% assign last = parts | last | slice: 0, 10 %}
+    <li>
+      <span>
+        <span class="idea-head">
+          <a href="{{ a.url | relative_url }}">{{ a.title }}</a>
+          {% if a.status %}<span class="status status-{{ a.status | slugify }}">{{ a.status }}</span>{% endif %}
+        </span>
+        {% if a.summary %}<span class="model-summary">{{ a.summary }}</span>{% endif %}
+      </span>
+      <span class="idea-meta">
+        {% if n > 0 %}<time datetime="{{ last }}">{{ last | date: "%b %d, %Y" }}</time>
+        <span>{{ n }} entr{% if n == 1 %}y{% else %}ies{% endif %}{% if n > 1 %} · since {{ first | date: "%b %d" }}{% endif %}</span>{% endif %}
+      </span>
+    </li>
+    {% endfor %}
+  </ul>
+  {% else %}
+  <p class="empty">No attempts yet. Copy <code>_drafts/attempt-template.html</code> into <code>_attempts/</code> to start one.</p>
+  {% endif %}
+</main>
+
+<footer class="article">
+  <p>{{ site.title }} · ETH Zurich</p>
+</footer>
+</body>
+</html>
