diff --git a/css/style.css b/css/style.css
index d1f139c..48c1fb6 100644
--- a/css/style.css
+++ b/css/style.css
@@ -449,6 +449,34 @@ a:focus-visible, .links a:focus-visible, input:focus-visible {
 }
 .empty { color: var(--muted); }
 
+/* ---- Lists on the homepage (see _data/lists.yml) ---- */
+.list-filter { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.6rem 0 0; }
+.list-filter a {
+  font-family: var(--sans);
+  font-size: .82rem;
+  font-weight: 500;
+  text-decoration: none;
+  color: var(--muted);
+  border: 1px solid var(--rule);
+  border-radius: 999px;
+  padding: .35rem .95rem;
+  transition: color .15s, border-color .15s, background .15s;
+}
+.list-filter a:hover { color: var(--ink); border-color: var(--muted); }
+.list-filter a.active { color: var(--paper); background: var(--ink); border-color: var(--ink); }
+.list-section { margin-top: 2.6rem; }
+.list-section .list-name { font-size: 1.3rem; margin: 0 0 .25rem; }
+.list-name .count {
+  font-family: var(--mono);
+  font-size: .72rem;
+  font-weight: 400;
+  color: var(--muted);
+  vertical-align: middle;
+  margin-left: .35rem;
+}
+.list-desc { color: var(--muted); font-size: 1rem; margin: 0 0 .9rem; }
+.list-section .post-list { margin-top: 0; }
+
 /* Footer divider spans the text column only */
 footer::before {
   content: "";
diff --git a/index.html b/index.html
index a4706ca..03e0dc1 100644
--- a/index.html
+++ b/index.html
@@ -25,21 +25,74 @@
 </header>
 
 <main class="article">
-  <!-- Built automatically from the files in _posts/, newest first -->
-  {% if site.posts.size > 0 %}
-  <ul class="post-list">
-    {% for post in site.posts %}
-    <li>
-      <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
-      <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: "%b %d, %Y" }}</time>
-    </li>
+  <!-- Built automatically from the files in _posts/, newest first.
+       The lists and their order come from _data/lists.yml. -->
+  {% assign lists = site.data.lists %}
+  {% assign list_ids = lists | map: "id" %}
+
+  <nav class="list-filter" aria-label="Show list">
+    <a href="#all" data-list="all" class="active">All</a>
+    {% for l in lists %}<a href="#{{ l.id }}" data-list="{{ l.id }}">{{ l.name }}</a>
     {% endfor %}
-  </ul>
-  {% else %}
-  <p class="empty">No notes yet.</p>
+  </nav>
+
+  {% for l in lists %}
+  {% assign posts = site.posts | where: "list", l.id %}
+  <section class="list-section" id="{{ l.id }}" data-list="{{ l.id }}">
+    <h2 class="list-name">{{ l.name }} <span class="count">{{ posts.size }}</span></h2>
+    {% if l.description %}<p class="list-desc">{{ l.description }}</p>{% endif %}
+    {% if posts.size > 0 %}
+    <ul class="post-list">
+      {% for post in posts %}
+      <li>
+        <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
+        <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: "%b %d, %Y" }}</time>
+      </li>
+      {% endfor %}
+    </ul>
+    {% else %}
+    <p class="empty">No notes yet.</p>
+    {% endif %}
+  </section>
+  {% endfor %}
+
+  <!-- Posts without a (known) list: line end up here -->
+  {% capture other %}{% for post in site.posts %}{% unless list_ids contains post.list %}
+      <li>
+        <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
+        <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: "%b %d, %Y" }}</time>
+      </li>{% endunless %}{% endfor %}{% endcapture %}
+  {% if other contains "<li>" %}
+  <section class="list-section" id="other" data-list="other">
+    <h2 class="list-name">Other</h2>
+    <ul class="post-list">{{ other }}
+    </ul>
+  </section>
   {% endif %}
 </main>
 
+<script>
+  // "All / Master Thesis / AI Safety" buttons: show one list at a time.
+  // The choice is kept in the address (e.g. /#ai-safety), so you can link to a list.
+  (function () {
+    var buttons = document.querySelectorAll('.list-filter a');
+    var sections = document.querySelectorAll('.list-section');
+    function show(id) {
+      if (!document.querySelector('.list-section[data-list="' + id + '"]')) id = 'all';
+      sections.forEach(function (s) { s.hidden = id !== 'all' && s.dataset.list !== id; });
+      buttons.forEach(function (b) { b.classList.toggle('active', b.dataset.list === id); });
+    }
+    buttons.forEach(function (b) {
+      b.addEventListener('click', function (e) {
+        e.preventDefault();
+        history.replaceState(null, '', b.dataset.list === 'all' ? location.pathname : '#' + b.dataset.list);
+        show(b.dataset.list);
+      });
+    });
+    show(location.hash.slice(1) || 'all');
+  })();
+</script>
+
 <footer class="article">
   <p>Master Thesis Reading Log · ETH Zurich</p>
 </footer>
